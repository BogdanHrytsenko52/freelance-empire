# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local Vite frontend. Add deployed frontend origins here rather than enabling
# CORS for every origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI and simulation (used by later implementation stages)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_ENABLED=False
GROQ_TIMEOUT_SECONDS=15
GROQ_MAX_RETRIES=2
GROQ_MAX_OUTPUT_TOKENS=300
AI_MAX_MESSAGE_LENGTH=1000
AI_MAX_HISTORY_MESSAGES=20
AI_REQUESTS_PER_MINUTE=5
AI_MAX_NEGOTIATION_MESSAGES=10
GAME_DAY_DURATION_SECONDS=3600

# JWT lifetime and rate limits
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
AUTH_LOGIN_THROTTLE=5/min
AUTH_REGISTER_THROTTLE=3/min
AUTH_REFRESH_THROTTLE=10/min
